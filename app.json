{
  "expo": {
    "name": "MetarCheck",
    "slug": "MetarCheck",
    "scheme": "metar-scheme",
    "experiments": {
      "typedRoutes": true
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/logo-no-bg.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo/logo-no-bg.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.MetarCheck"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/logo-no-bg.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MetarCheck"
    },
    "web": {
      "favicon": "./assets/logo/logo-no-bg.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
